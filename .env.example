# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.
# See docs/SETUP.md for how to obtain each of these.

# ---------------------------------------------------------------------------
# Firebase client SDK config (public — safe to expose to the browser).
# From Firebase Console → Project settings → General → Your apps → Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (SERVER-ONLY — never prefix with NEXT_PUBLIC_).
# From Firebase Console → Project settings → Service accounts →
# Generate new private key. Set these as server-side env vars in Vercel
# (not exposed to the client), never commit the downloaded JSON file.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SEO — search engine verification
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Analytics (optional — leave blank until configured)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Google Reviews (SERVER-ONLY — never prefix with NEXT_PUBLIC_).
# Ready to use once set; the homepage falls back to an honest empty state
# when either is unset. Full setup steps in docs/SETUP.md, "Google Reviews".
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Not yet wired up — the booking form doesn't send a notification email yet.
RESEND_API_KEY=

# The booking form (lib/inquiries/actions.ts) is ready for Turnstile: when
# both of these are set, submissions are verified server-side; when unset,
# verification is a no-op (there's no widget on the form yet either, so
# there's no token to check) — see lib/security/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
