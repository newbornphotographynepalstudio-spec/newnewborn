# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.
# See docs/SETUP.md for how to obtain each of these.

# ---------------------------------------------------------------------------
# Firebase client SDK config (public — safe to expose to the browser).
# From Firebase Console → Project settings → General → Your apps → Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (SERVER-ONLY — never prefix with NEXT_PUBLIC_).
# From Firebase Console → Project settings → Service accounts →
# Generate new private key. Set these as server-side env vars in Vercel
# (not exposed to the client), never commit the downloaded JSON file.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Supabase Storage (SERVICE ROLE KEY is SERVER-ONLY — never prefix
# NEXT_PUBLIC_ or expose it to the browser). This project stays on the
# Firebase Spark plan, which doesn't include Firebase Storage — Media
# Library photo uploads use Supabase Storage instead; Firestore/Auth stay
# on Firebase. Create a project at supabase.com, then Storage → create a
# public bucket named "media". NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are both public/safe (like Stripe's
# publishable key) — this codebase doesn't currently use the publishable
# key anywhere, it's recorded for completeness only. SUPABASE_SERVICE_ROLE_KEY
# is the one that matters: Project Settings → API → on Supabase's legacy
# key system it's literally named "service_role"; on the newer API key
# system the equivalent full-privilege server key is under "Secret keys."
# Either way, treat it exactly like the Firebase private key — every
# admin Storage operation (lib/supabase/admin.ts) requires it specifically
# so writes stay gated by this app's own admin session check, never by a
# Supabase Storage policy keyed to the publishable key (which must remain
# safe to expose to the browser).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SEO — search engine verification
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Analytics (optional — leave blank until configured)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Google Reviews — intentionally left unconfigured (SERVER-ONLY if ever
# set — never prefix with NEXT_PUBLIC_). This is a low-budget project and
# enabling this would require a Google Cloud Billing account, which is
# out of scope. Do not set either variable. The homepage's honest empty
# state (a link to the real Google review page, no invented reviews) is
# the correct, permanent behavior. See docs/SETUP.md, "Google Reviews —
# intentionally disabled".
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# ---------------------------------------------------------------------------
# Booking email notifications (SERVER-ONLY). When set, the studio is
# emailed at every new booking (lib/email/booking-notification.ts) — the
# booking still saves to Firestore and appears in admin either way; this
# only affects the email. Free tier: sign up at resend.com, copy the API
# key from the dashboard (no domain verification needed to start — the
# default sender works immediately for this volume).
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# The booking form (lib/inquiries/actions.ts) is ready for Turnstile: when
# both of these are set, submissions are verified server-side; when unset,
# verification is a no-op (there's no widget on the form yet either, so
# there's no token to check) — see lib/security/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
