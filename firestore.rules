rules_version = '2';

// Phase 1 foundation: deny-all by default.
//
// No collections are defined yet (see docs/ARCHITECTURE.md for the planned
// schema). When collections are added in Phase 2, add explicit per-
// collection rules below — public reads only for published content,
// create-only for public lead/inquiry submissions, and every other write
// gated on `request.auth.token.role` (custom claims set server-side via
// the Firebase Admin SDK, never trusted from client input). Do not replace
// this default with a blanket `allow read, write: if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
